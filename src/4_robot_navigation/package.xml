<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 integration, semantic location lookup, and mission task manager for Hospital Robot</description>
  <maintainer email="binh.nguyen.e1@ctuav.vn">binhnguyenduc</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>python3-yaml</depend>
  <depend>robot_bringup</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

